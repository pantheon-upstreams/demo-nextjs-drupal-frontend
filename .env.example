# Drupal Backend Configuration
# Copy this file to .env.local or .env.development and update with your values
# See https://next-drupal.org/docs/environment-variables

# Required
# Drupal backend runs as its own DDEV project (d11-nextjs-be). This URL is used both in the
# browser and for server-side fetches (the .ddev/docker-compose.backend.yaml host-gateway
# mapping routes the container to the same host).
NEXT_PUBLIC_DRUPAL_BASE_URL=https://d11-nextjs-be.ddev.site
NEXT_IMAGE_DOMAIN=d11-nextjs-be.ddev.site

# Authentication (must match the Drupal Simple OAuth consumer; see
# ../drupal/.ddev/commands/web/configure-preview)
DRUPAL_CLIENT_ID=default_consumer
DRUPAL_CLIENT_SECRET=nextjs-drupal

# Required for On-demand Revalidation
DRUPAL_REVALIDATE_SECRET=nextjs-drupal

# Required for Draft Mode: Drupal Preview Secret (for draft content preview)
# This should match the preview secret configured in your Drupal NextJS module
DRUPAL_PREVIEW_SECRET=nextjs-drupal
